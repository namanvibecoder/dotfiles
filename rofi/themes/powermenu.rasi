/* Dark Minimal Rofi Theme */

* {
    bg:         #1e1e2e;
    bg-alt:     #313244;
    fg:         #cdd6f4;
    fg-alt:     #f38ba8;

    background-color:   @bg;
    text-color:         @fg;

    border: 0;
    margin: 0;
    padding: 0;
}

window {
    width: 300px;
    border-radius: 0px;
    background-color: @bg;
}

mainbox {
    padding: 16px;
}

listview {
    spacing: 10px;
    lines: 5;
}

element {
    padding: 8px;
    border-radius: 0px;
    background-color: @bg-alt;
}

element selected {
    background-color: @fg-alt;
    text-color: @bg;
}

prompt {
    enabled: true;
    text-color: @fg;
    margin-bottom: 10px;
}

textbox-prompt-colon {
    expand: false;
    margin-right: 0px;
}
